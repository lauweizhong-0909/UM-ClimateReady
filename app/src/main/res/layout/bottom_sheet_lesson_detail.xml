<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/divider_line" />

        <!-- Category badge -->
        <TextView
            android:id="@+id/tv_detail_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/climate_green_container"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/learning_accent_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="🌧 Heavy Rain" />

        <!-- Unit title -->
        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Understanding Heavy Rainfall" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/divider_line" />

        <!-- Summary section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learning_section_summary"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Summary text" />

        <!-- Real-World Example card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/learning_example_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/um_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learning_section_example"
                    android:textColor="@color/learning_example_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_real_world_example"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/learning_example_body"
                    android:textSize="13sp"
                    tools:text="Real world example" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- UM Student Tip card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/learning_tip_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/learning_tip_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learning_section_um_tip"
                    android:textColor="@color/learning_tip_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_um_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/learning_tip_body"
                    android:textSize="13sp"
                    tools:text="UM student tip" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CCNA Knowledge Check card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_knowledge_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/learning_kc_accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learning_section_knowledge_check"
                    android:textColor="@color/learning_kc_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_kc_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Question?" />

                <!-- Option A -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_a"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:strokeColor="@color/divider_line"
                    tools:text="A. Option" />

                <!-- Option B -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_b"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="start|center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:strokeColor="@color/divider_line"
                    tools:text="B. Option" />

                <!-- Option C -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_c"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="start|center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:strokeColor="@color/divider_line"
                    tools:text="C. Option" />

                <!-- Option D -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_d"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="start|center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:strokeColor="@color/divider_line"
                    tools:text="D. Option" />

                <!-- Explanation (hidden until an option is selected) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/learning_explanation_bg"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tv_kc_explanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.4"
                        android:padding="12dp"
                        android:textColor="@color/learning_explanation_text"
                        android:textSize="13sp"
                        tools:text="Explanation" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key Takeaway card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/um_navy"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learning_section_takeaway"
                    android:textColor="@color/um_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_takeaway"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="Takeaway" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mark as Completed button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="14dp"
            android:text="@string/learning_btn_mark_complete"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
