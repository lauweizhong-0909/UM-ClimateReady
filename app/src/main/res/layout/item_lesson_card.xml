<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/climate_green_container">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Unit order number badge -->
        <TextView
            android:id="@+id/tv_unit_number"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_unit_number"
            android:gravity="center"
            android:text="01"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Completion checkmark badge (shown only when isCompleted = true) -->
        <ImageView
            android:id="@+id/iv_completion_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Completed"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tv_unit_number"
            app:layout_constraintTop_toTopOf="@id/tv_unit_number"
            app:tint="@color/score_green" />

        <!-- Category badge chip -->
        <TextView
            android:id="@+id/tv_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@color/climate_green_container"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Heavy Rain"
            android:textColor="@color/climate_green_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_unit_number"
            app:layout_constraintStart_toEndOf="@id/tv_unit_number"
            app:layout_constraintTop_toTopOf="@id/tv_unit_number" />

        <!-- Unit title -->
        <TextView
            android:id="@+id/tv_unit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Unit Title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/iv_completed_right"
            app:layout_constraintStart_toEndOf="@id/tv_unit_number"
            app:layout_constraintTop_toBottomOf="@id/tv_category_badge" />

        <!-- Summary snippet -->
        <TextView
            android:id="@+id/tv_unit_summary_snippet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Summary snippet…"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/iv_completed_right"
            app:layout_constraintStart_toEndOf="@id/tv_unit_number"
            app:layout_constraintTop_toBottomOf="@id/tv_unit_title" />

        <!-- Right-side completed indicator (green tick visible when done) -->
        <ImageView
            android:id="@+id/iv_completed_right"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Unit completed"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/score_green" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
